# DataContractor Configuration
# Copy this file to .env and adjust values for your environment.

# === Core ===
DATABASE_URL=postgresql://datacontractor:datacontractor@localhost:5432/datacontractor
APP_ENV=development               # development | staging | production
APP_DEBUG=false                    # Never set to true in production (may leak SQL queries)
APP_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
APP_LOG_FORMAT=text                # text | json

# === Database Pool ===
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# === CORS ===
CORS_ORIGINS=http://localhost:8501

# === Security ===
API_KEY=                           # Set a non-empty value to enable API key authentication
ALLOWED_DATA_DIR=/app/data
MAX_REQUEST_SIZE_MB=10
API_RATE_LIMIT=60                  # requests per minute per IP
